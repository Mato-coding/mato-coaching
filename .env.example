# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=hello@lassekluever.de

# Lead-Magnet-Audio (Breathwork), siehe /api/lead
LEAD_AUDIO_URL=https://www.lassekluever.de/audio/physiological-sigh.m4a

# Vercel Cron (Supabase-Keep-alive, siehe src/app/api/cron/keep-alive)
CRON_SECRET=

# Feedback-Formular (/feedback), siehe Bau-Auftrag Feedback-Seite in CLAUDE.md.
# Direkter "Bewertung schreiben"-Link aus dem Google-Unternehmensprofil.
# Fehlt diese Variable, zeigt die Danke-Ansicht nur den Mailto-Button.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Absolute URL zum Dankeschön-Audio der Feedback-Seite (public/audio/...).
# Fehlt diese Variable, entfällt der Audio-Block in der Danke-Ansicht,
# eine Warnung landet im Server-Log statt eines stillen Fallbacks.
NEXT_PUBLIC_FEEDBACK_AUDIO_URL=
